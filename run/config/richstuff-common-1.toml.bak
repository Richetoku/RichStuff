[processing]
	#Enable budding RichStuff crystal blocks to grow crystal blocks in adjacent air.
	enableCrystalGrowth = true
	#Generated Create recipe JSON is gated with a create mod_loaded condition.
	createRecipesRequireCreate = true
	#Enable direct vanilla crafting/smelting shortcuts. Disabled by default so materials must use the processing chain or powered machines.
	enableVanillaFallbackRecipes = false

[metal_slimes]
	#Enable colored RichStuff metal slimes that drop matching metal nuggets.
	enableMetalSlimes = true
	#Global multiplier applied to metal slime spawn-rule chances. Biome modifier weights remain data-pack controlled.
	# Default: 1.0
	# Range: 0.0 ~ 64.0
	metalSlimeSpawnMultiplier = 1.0
